VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Turns the demo sandbox off (writes reach Supabase for real).
# VITE_DEMO_MODE=false

# Optional, recommended on every deployment. The project ref this build is
# meant to talk to — the "<ref>" in https://<ref>.supabase.co. If
# VITE_SUPABASE_URL ever points somewhere else, the app refuses to start
# instead of quietly serving one project's data from another's deployment.
# Demo mode blocks writes but not reads, so a demo build aimed at a school
# project would publish that school's student records.
# VITE_EXPECTED_PROJECT_REF=
